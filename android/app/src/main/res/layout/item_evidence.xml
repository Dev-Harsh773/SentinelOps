<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_evidence_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/level_error"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textColor="@color/surface"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="ERROR" />

        <TextView
            android:id="@+id/tv_evidence_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            tools:text="14:22:01 UTC" />

        <TextView
            android:id="@+id/tv_evidence_service"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="api-gateway" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_evidence_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        tools:text="Unhandled DatabaseTimeoutException: connection pool exhausted at query_users()" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/border" />

</LinearLayout>
