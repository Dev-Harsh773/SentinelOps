<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_severity"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="CRITICAL"
            android:textColor="@color/severity_critical"
            android:textSize="11sp"
            android:textStyle="bold"
            app:chipBackgroundColor="@color/severity_critical_bg"
            app:chipMinTouchTargetSize="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_status"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:text="OPEN"
            android:textColor="@color/incident_open"
            android:textSize="11sp"
            android:textStyle="bold"
            app:chipBackgroundColor="@color/surface_variant"
            app:chipMinTouchTargetSize="0dp"
            app:layout_constraintStart_toEndOf="@id/chip_severity"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_incident_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="@id/chip_status"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/chip_status"
            tools:text="10m ago" />

        <TextView
            android:id="@+id/tv_incident_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chip_severity"
            tools:text="Elevated 500 error rates on /api/v1/checkout" />

        <TextView
            android:id="@+id/tv_incident_service"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_incident_title"
            tools:text="checkout-service (production)" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
