<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_connector_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/chip_connector_type"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Production Health Poller" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_connector_type"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:text="HTTP POLLER"
            android:textColor="@color/accent"
            android:textSize="10sp"
            android:textStyle="bold"
            app:chipBackgroundColor="@color/surface_variant"
            app:chipMinTouchTargetSize="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/layout_status_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tv_connector_name">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_operational_status"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:text="HEALTHY"
                android:textColor="@color/status_online"
                android:textSize="10sp"
                android:textStyle="bold"
                app:chipBackgroundColor="@color/status_online_bg"
                app:chipMinTouchTargetSize="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_target_status"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:text="TARGET: HEALTHY"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                app:chipBackgroundColor="@color/surface_variant"
                app:chipMinTouchTargetSize="0dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_connector_url"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_status_row"
            tools:text="http://api.production.internal/health" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tv_connector_url">

            <TextView
                android:id="@+id/tv_connector_last_poll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                tools:text="Last poll: 2m ago" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_connector_test"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="12dp"
                android:text="@string/connector_action_test"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/progress_connector_test"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
