<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_change_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/surface_variant"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textColor="@color/accent"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="MODIFY" />

        <TextView
            android:id="@+id/tv_change_file"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="app/services/checkout.py" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_change_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        tools:text="Add connection timeout handling with retry backoff." />

    <TextView
        android:id="@+id/tv_change_reason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        tools:text="Addresses RCA: Database connection pooling exhaustion." />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/border" />

</LinearLayout>
