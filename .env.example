# Application Configuration
APP_NAME=sentinelops
APP_ENV=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# Telemetry / Evidence Log Source
DEMO_APP_LOG_PATH=runtime/demo_app.jsonl

# Source Repository Configuration
SOURCE_REPOSITORY_PATH=demo_app

# Git Repository Configuration
GIT_REPOSITORY_PATH=.

# LLM Configuration
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key

# Durable notification worker (pending intent is retained when disabled)
NOTIFICATIONS_ENABLED=true
NOTIFICATION_POLL_INTERVAL_SECONDS=1
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_BASE_SECONDS=2
NOTIFICATION_RETRY_CAP_SECONDS=60
# Minimum 65 seconds; exceeds validation + total webhook request deadline
NOTIFICATION_LEASE_SECONDS=120

# Stage 24: set APP_ENV=production for hosted/container use.
# Production requires a private token of at least 32 characters and an absolute
# persistent RUNTIME_DIR outside the packaged application directory.
RUNTIME_DIR=runtime
SENTINELOPS_OPERATOR_TOKEN=
# Production defaults workspaces to RUNTIME_DIR/workspaces.
# SENTINEL_WORKSPACES_ROOT=/var/lib/sentinelops/workspaces
# PUBLIC_INGRESS_URL=https://your-sentinelops-service.onrender.com
CORS_ALLOWED_ORIGINS=
MAX_REQUEST_BODY_SIZE=10485760
RATE_LIMIT_INGEST_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_EXPENSIVE_PER_MINUTE=10
RATE_LIMIT_MAX_KEYS=4096
LOG_JSON=false
